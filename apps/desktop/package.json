{
  "name": "trove-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app built with Tauri 2 and Svelte 5.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@lucide/svelte": "^1.56.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
