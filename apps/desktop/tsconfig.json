{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  // SvelteKit 3 generates this instead of .svelte-kit/tsconfig.json.
  // TypeScript does not merge `include`, so the entries the generated config had are copied here.
  // playwright.config.ts is left out on purpose: it reads process.env, and the project has no
  // @types/node (see the @ts-expect-error in vite.config.js). Including it would fail the check.
  "include": [
    "src",
    "vite.config.js"
  ]
}